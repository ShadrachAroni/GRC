# SecureBank GRC Platform Environment Variables Template
# Copy this file to .env and fill in your keys.

ENVIRONMENT=development

# Database Settings
DATABASE_URL=postgresql://user:password@host:5432/securebank
# For local SQLite development:
# DATABASE_URL=sqlite:///./grcdb.db

# Authentication Keys
JWT_SECRET_KEY=your-super-secret-256-bit-key-for-jwts-here

# Third-Party Integrations
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# CORS & Gateway Settings
DEV_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PROD_ORIGINS=https://myapp.com,https://www.myapp.com
PORT=8000
HOST=0.0.0.0
